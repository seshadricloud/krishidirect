# Contents of /KrishiDirect/KrishiDirect/.env.example

# Example environment variables for the KrishiDirect application
# Rename this file to .env and fill in the values as needed

# Backend Configuration
PORT=5000
DATABASE_URL="your_database_connection_string"
JWT_SECRET="your_jwt_secret"
NODE_ENV="development"

# Frontend Configuration
REACT_APP_API_URL="http://localhost:5000/api"